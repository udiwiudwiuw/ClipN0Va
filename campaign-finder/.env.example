# ─────────────────────────────────────────────────────────────────────────────
# ClipNova Campaign Video Finder — configuratie
# Kopieer naar `.env`:   cp .env.example .env
# Alles is optioneel behalve DATABASE_URL. Zonder sleutels draait de app op de
# ingebouwde Demo Data Engine en de heuristische analyse, zodat alles direct
# testbaar is.
# ─────────────────────────────────────────────────────────────────────────────

# SQLite-database (pad relatief aan de map prisma/)
DATABASE_URL="file:./dev.db"

# ── Video zoeken ────────────────────────────────────────────────────────────
# auto    = YouTube API als YOUTUBE_API_KEY er is, anders RSS voor kanaalbronnen
#           (geen sleutel nodig) aangevuld met demo-data
# youtube = alleen YouTube Data API v3
# rss     = alleen openbare YouTube-kanaalfeeds (geen sleutel, geen duur/views)
# mock    = alleen demo-data (offline)
SEARCH_MODE="auto"

# YouTube Data API v3
# 1. https://console.cloud.google.com/ → nieuw project
# 2. "APIs & Services" → Library → "YouTube Data API v3" → Enable
# 3. Credentials → Create credentials → API key (beperk hem tot YouTube Data API v3)
# Quotum: 10.000 eenheden/dag; één zoekopdracht kost 100, videodetails 1 per 50 video's.
YOUTUBE_API_KEY=""
# Max. resultaten per zoekopdracht (per zoekwoord/kanaal), 1-50
YOUTUBE_MAX_RESULTS="15"

# ── AI-analyse ──────────────────────────────────────────────────────────────
# auto      = OpenAI als OPENAI_API_KEY er is, anders Anthropic, anders heuristisch
# openai | anthropic | heuristic  = forceer een provider
AI_PROVIDER="auto"

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Hoeveel video's tegelijk worden geanalyseerd
ANALYSIS_CONCURRENCY="3"

# ── Achtergrondtaken ────────────────────────────────────────────────────────
# Zet op 0 om periodiek zoeken uit te zetten (handmatig zoeken blijft werken)
SCHEDULER_ENABLED="1"
