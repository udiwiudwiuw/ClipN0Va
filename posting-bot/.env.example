# ─────────────────────────────────────────────────────────────────────────────
# ClipNova Posting Bot — configuratie
# Kopieer naar `.env`:   cp .env.example .env
# Alles is optioneel behalve DATABASE_URL. Zonder platform-sleutels draait de
# app automatisch in MOCK MODE: koppelen en publiceren wordt dan lokaal
# gesimuleerd, zodat de UI, planner en wachtrij volledig testbaar zijn.
# ─────────────────────────────────────────────────────────────────────────────

# SQLite-database (pad is relatief aan de map prisma/)
DATABASE_URL="file:./dev.db"

# Publiek https-adres van deze app. Nodig voor OAuth-redirects en voor
# Instagram (Instagram haalt de video zelf op via een publieke URL).
PUBLIC_BASE_URL="http://localhost:3000"

# Waar geüploade/geïmporteerde clips worden opgeslagen
STORAGE_DIR="./storage"

# Optioneel: map die "Importeer uit map" scant (mp4/mov/webm)
IMPORT_DIR="./storage/inbox"

# Optioneel: de storage-map van ClipNova (backend/storage). "Importeer uit
# ClipNova" leest daar elke <job>/job.json en neemt titel, bijschrift en
# hashtags van iedere clip over.
CLIPNOVA_STORAGE_DIR=""

# Optioneel: 32+ tekens. Versleutelt access/refresh tokens in de database (AES-256-GCM).
TOKEN_ENCRYPTION_KEY=""

# Standaardtijdzone voor nieuwe accounts
DEFAULT_TIMEZONE="Europe/Amsterdam"

# Interval van de worker in seconden (hoe vaak de wachtrij wordt gecontroleerd)
WORKER_INTERVAL_SECONDS="15"
# Zet op 0 om de achtergrond-worker niet automatisch te starten
WORKER_ENABLED="1"

# ── Mock mode ───────────────────────────────────────────────────────────────
# Forceer mock mode, ook als er wel sleutels zijn ("1" = altijd mock)
MOCK_MODE=""
# Kans (0..1) dat een gesimuleerde upload een tijdelijke netwerkfout geeft
# — handig om de retry-logica te zien werken.
MOCK_FAILURE_RATE="0.1"
# Gesimuleerde upload-duur in ms
MOCK_LATENCY_MS="800"

# ── OpenAI (bijschriften & hashtags) ─────────────────────────────────────────
# https://platform.openai.com/api-keys — zonder sleutel gebruikt de app een
# ingebouwde sjabloon-generator (ook met variatie per account).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ── TikTok (Content Posting API) ─────────────────────────────────────────────
# 1. Maak een app op https://developers.tiktok.com/ → "Manage apps".
# 2. Voeg de producten "Login Kit" en "Content Posting API" toe.
# 3. Scopes: user.info.basic, video.publish, video.upload
# 4. Redirect URI: {PUBLIC_BASE_URL}/api/oauth/tiktok/callback
# Let op: tot je app door TikTok is geaudit, worden posts als privé geplaatst.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# PUBLIC_TO_EVERYONE, MUTUAL_FOLLOW_FRIENDS, FOLLOWER_OF_CREATOR of SELF_ONLY
TIKTOK_PRIVACY_LEVEL="SELF_ONLY"

# ── YouTube Shorts (YouTube Data API v3) ─────────────────────────────────────
# 1. https://console.cloud.google.com/ → nieuw project → "YouTube Data API v3" inschakelen.
# 2. OAuth-toestemmingsscherm instellen, scope: https://www.googleapis.com/auth/youtube.upload
#    en https://www.googleapis.com/auth/youtube.readonly
# 3. Credentials → OAuth client ID (Web application)
# 4. Redirect URI: {PUBLIC_BASE_URL}/api/oauth/youtube/callback
# Elk kanaal koppel je apart (kies het kanaal in het Google-scherm).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# public, unlisted of private
YOUTUBE_PRIVACY_STATUS="private"

# ── Instagram Reels (Instagram API met Instagram Login) ──────────────────────
# 1. https://developers.facebook.com/ → app van type "Business".
# 2. Voeg het product "Instagram" toe → "API setup with Instagram login".
# 3. Scopes: instagram_business_basic, instagram_business_content_publish
# 4. Redirect URI: {PUBLIC_BASE_URL}/api/oauth/instagram/callback
# Alleen professionele (Business/Creator) accounts. PUBLIC_BASE_URL moet
# publiek bereikbaar zijn via https, want Instagram downloadt de video zelf.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# ── Beveiliging (aanbevolen zodra de app online staat) ───────────────────────
# Zet de hele app achter HTTP Basic Auth (gebruikersnaam mag alles zijn).
APP_PASSWORD=""
# Geheim voor ondertekende media-URL's (Instagram). Valt terug op TOKEN_ENCRYPTION_KEY / APP_PASSWORD.
MEDIA_SIGNING_SECRET=""
